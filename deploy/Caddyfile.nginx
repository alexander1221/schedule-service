# Only for nginx HTTPS -> 127.0.0.1:18000 -> this HTTP listener.
# Do not expose this listener publicly: the upstream HTTPS scheme is fixed below.
:80 {
	encode gzip

	handle_path /static/* {
		root * /srv/static
		file_server
		header Cache-Control "public, max-age=86400"
	}

	handle {
		reverse_proxy web:8000 {
			header_up X-Forwarded-Proto https
		}
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		-Server
	}
}
