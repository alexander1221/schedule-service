# SITE_ADDRESS из .env:
#   raspisanie.college.ru   — домен: Caddy сам получит и будет продлевать сертификат HTTPS
#                             (порты 80 и 443 должны быть открыты из интернета)
#   :80                     — без домена, только http:// внутри сети колледжа (пилот)
{$SITE_ADDRESS} {
	encode gzip

	handle_path /static/* {
		root * /srv/static
		file_server
		header Cache-Control "public, max-age=86400"
	}

	handle {
		reverse_proxy web:8000
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		-Server
	}
}
