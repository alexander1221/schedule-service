# Скопируйте этот файл в .env (в ту же папку) и заполните. Файл .env не попадает в архивы и git.
# Заданное в системе (переменные окружения) важнее того, что здесь.

# ---- почта для кодов входа -------------------------------------------------------------
# Без EMAIL_HOST письма с кодами печатаются в окне, где запущен сервер (удобно для проверки).
# Яндекс:  smtp.yandex.ru, порт 465.   Mail.ru: smtp.mail.ru, порт 465.
# Пароль — не от ящика, а «пароль приложения» из настроек безопасности почты.
#EMAIL_HOST=smtp.yandex.ru
#EMAIL_PORT=465
#EMAIL_HOST_USER=raspisanie@college.ru
#EMAIL_HOST_PASSWORD=пароль-приложения
#DEFAULT_FROM_EMAIL=Расписание <raspisanie@college.ru>

# ---- сервер (docker compose, docs/DEPLOY.md) ----------------------------------------------
# Адрес сайта для Caddy: домен (HTTPS получится сам) или :80 (только http внутри сети колледжа).
#SITE_ADDRESS=raspisanie.college.ru
#DJANGO_ALLOWED_HOSTS=raspisanie.college.ru
#DJANGO_CSRF_TRUSTED_ORIGINS=https://raspisanie.college.ru
# Секретный ключ: python -c "import secrets; print(secrets.token_urlsafe(50))"
#DJANGO_SECRET_KEY=
# Пароль базы (любой длинный, придумать один раз и не менять):
#DB_PASSWORD=
# Сколько ядер процессора отдавать решателю (по умолчанию — все, кроме одного; остальное — сайту):
#SOLVER_MAX_WORKERS=3
# Пилот без HTTPS (SITE_ADDRESS=:80) — иначе вход не сработает:
#DJANGO_SECURE_COOKIES=0
# Для запуска без docker на своей машине (runserver) эти строки не нужны.
